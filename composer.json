{
    "name": "derafu/contact-form",
    "description": "Derafu: Contact Form",
    "type": "library",
    "homepage": "https://www.derafu.dev/docs/ui/contact-form",
    "license": "MIT",
    "authors": [
        {
            "name": "Esteban De La Fuente Rubio / Derafu",
            "homepage": "https://www.derafu.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/derafu/contact-form/issues",
        "source": "https://github.com/derafu/contact-form"
    },
    "autoload": {
        "psr-4": {
            "Derafu\\ContactForm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Derafu\\TestsContactForm\\": "tests/src/"
        }
    },
    "require": {
        "php": "^8.5",
        "derafu/http": "dev-main",
        "derafu/form": "dev-main",
        "derafu/data-processor": "dev-main",
        "derafu/translation": "dev-main",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "guzzlehttp/guzzle": "^7.10",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.4",
        "nikic/php-parser": "^5.9"
    },
    "suggest": {
        "nikic/php-parser": "Required by the tests of the messages of the package (Derafu\\Translation\\Lint reads the code).",
        "guzzlehttp/guzzle": "A PSR-18 HTTP client and the PSR-17 factories (GuzzleHttp\\Psr7\\HttpFactory) to send the message to the webhook, if the application has no other."
    },
    "scripts": {
        "docs": "php tools/phpdocumentor run --config=phpdoc.xml",
        "tests": "XDEBUG_MODE=coverage vendor/bin/phpunit --configuration=phpunit.xml",
        "phpcs-fix": "vendor/bin/php-cs-fixer fix -v --config=php-cs-fixer.php",
        "phpcs": "vendor/bin/php-cs-fixer fix -v --dry-run --diff --config=php-cs-fixer.php",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
        "phpstan-export": "vendor/bin/phpstan analyse --configuration=phpstan.neon --level 9 --generate-baseline",
        "build": "npm run build"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
