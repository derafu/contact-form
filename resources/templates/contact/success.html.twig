{% extends 'layouts/default.html.twig' %}
{% trans_default_domain 'contact-form+intl-icu' %}

{% block title %}{{ 'Message Sent'|trans }}{% endblock %}

{% block content %}

<twig:block-hero
    size="small"
    background="/img/contact/contact-hero.png"
    :contentBackground="true"
    title="{{ 'Thank You!'|trans }}"
    subtitle="{{ 'Your message has been sent.'|trans }}"
/>

<div class="my-5 container">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <p class="lead mb-4">
                {{ 'Thank you for reaching out.'|trans }}<br>
                {{ 'Our team appreciates your interest and will contact you soon.'|trans }}
            </p>
            <a href="{{ path('homepage') }}" class="btn btn-primary mt-3">{{ 'Back to Home'|trans }}</a>
        </div>
    </div>
</div>

{% endblock %}
